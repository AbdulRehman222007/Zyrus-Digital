# =========================================
# DEPENDENCIES
# =========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================================
# TESTING & BUILD OUTPUT
# =========================================
/coverage
/.next/
/out/
/build

# =========================================
# ENVIRONMENT VARIABLES (CRITICAL FOR SECURITY)
# =========================================
# Never commit your API keys, database URLs, or secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# =========================================
# DEBUG & SYSTEM FILES
# =========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# =========================================
# VERCEL & TYPESCRIPT
# =========================================
.vercel
*.tsbuildinfo
next-env.d.ts

# =========================================
# PROJECT SPECIFIC NOTES (OPTIONAL)
# =========================================
